# PS26227 Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Database Settings (PostgreSQL + PostGIS)
# Fallback to local SQLite / Spatialite mode when PostgreSQL container is offline
USE_LOCAL_SQLITE_FALLBACK=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih_eo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Vector Database (Qdrant)
# Fallback to in-process local Qdrant storage when docker container is offline
USE_LOCAL_QDRANT_STORAGE=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=./data/qdrant_storage
QDRANT_SEMANTIC_COLLECTION=semantic_tiles
QDRANT_SPECTRAL_COLLECTION=spectral_tiles

# Model Configurations & Local Checkpoint Paths
CLIP_RSICD_MODEL=flax-community/clip-rsicd-v2
CLAY_WEIGHTS_PATH=./data/weights/clay_v1_5.pt
OPEN_CD_CHECKPOINT=./data/weights/open_cd_snunet.pt
OPEN_CD_MODEL_TYPE=snunet

# Data Paths
DATA_RAW_DIR=./data/raw
DATA_TILES_DIR=./data/tiles
DATA_WEIGHTS_DIR=./data/weights
WATCH_FOLDER_DIR=./data/incoming

# Algorithm & Heuristic Thresholds
TILE_SIZE_PX=512
TILE_GSD_METERS=10.0
CLOUD_PROB_THRESHOLD=0.40
MAX_REGISTRATION_TOLERANCE_PX=5.0
CHANGE_CONFIDENCE_HIGH=0.70
CHANGE_CONFIDENCE_REVIEW=0.40
RANKING_WEIGHT_SEMANTIC=0.50
RANKING_WEIGHT_CHANGE=0.50
MULTIMODAL_WEIGHT_TEXT=0.50
MULTIMODAL_WEIGHT_IMAGE=0.50
